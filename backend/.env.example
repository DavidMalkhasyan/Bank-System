# Used by docker compose (development) and by the backend when run directly.
NODE_ENV=development
PORT=4000

# PostgreSQL. docker compose exposes it on localhost:15432.
DATABASE_URL=postgresql://postgres:postgres@localhost:15432/banking
# Set to true for hosted databases that require TLS (Neon, Supabase...).
DATABASE_SSL=false

# Optional cache. Leave empty to run without Redis.
REDIS_URL=redis://localhost:6380

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173

# Seed demo users and 4 months of history when the database is empty.
SEED_DEMO_DATA=true
# Wipe and reseed the demo every N hours (0 = never). Useful for a public demo.
DEMO_RESET_HOURS=0
